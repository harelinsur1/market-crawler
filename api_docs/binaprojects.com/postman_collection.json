{
  "info": {
    "name": "binaprojects.com",
    "description": "Bina Projects portals: every chain has its own subdomain `<key>.binaprojects.com` with the same API. Pick the chain in the server list.\n\nFlow: `POST /MainIO_Hok.aspx` (list a day's files) -> `GET /Download.aspx?FileNm=` (returns the real file url `SPath`) -> `GET /Download/{fileName}`.\n\n`citymarketkiryatgat` publishes both City Market Kiryat Gat chain ids (7290058266241 and 7290058288090).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// {{date}} = collection variable (YYYY-MM-DD) or today when empty.",
          "const pad = n => String(n).padStart(2, '0');",
          "const now = new Date();",
          "const iso = pm.collectionVariables.get('date') || `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;",
          "const [y, m, d] = iso.split('-');",
          "pm.variables.set('date', iso);",
          "pm.variables.set('dateCompact', y + m + d);",
          "pm.variables.set('dateDmy', `${d}/${m}/${y}`);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "date",
      "value": "",
      "description": "YYYY-MM-DD; empty = today"
    },
    {
      "key": "fileName",
      "value": ""
    },
    {
      "key": "fileUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "King Store (7290058108879)",
      "item": [
        {
          "name": "List PriceFull files",
          "request": {
            "method": "POST",
            "header": [],
            "url": "https://kingstore.binaprojects.com/MainIO_Hok.aspx",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "WStore",
                  "value": "",
                  "type": "text"
                },
                {
                  "key": "WDate",
                  "value": "{{date}}",
                  "type": "text"
                },
                {
                  "key": "WFileType",
                  "value": "4",
                  "type": "text"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "strictSSL": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const item = (pm.response.json()).find(f => (f.FileNm || '').startsWith('PriceFull'));",
                  "pm.test('found a PriceFull file', () => pm.expect(item).to.not.equal(undefined));",
                  "if (item) {",
                  "    pm.collectionVariables.set('fileName', item.FileNm);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolve download url",
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://kingstore.binaprojects.com/Download.aspx?FileNm={{fileName}}"
          },
          "protocolProfileBehavior": {
            "strictSSL": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const url = pm.response.json()[0].SPath;",
                  "pm.test('got SPath', () => pm.expect(url).to.be.a('string'));",
                  "pm.collectionVariables.set('fileUrl', url);"
                ]
              }
            }
          ]
        },
        {
          "name": "Download file",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{fileUrl}}",
            "description": "Use \"Send and Download\" to save the file."
          },
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        }
      ],
      "description": "King Store (7290058108879) - קינג סטור"
    },
