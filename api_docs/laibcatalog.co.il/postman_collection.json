{
  "info": {
    "name": "laibcatalog.co.il",
    "description": "laibcatalog.co.il portals (`laibcatalog.co.il/<chain>/index.html`). The API is keyed by chain id and ignores dates (returns the chain's whole current catalog).\n\nChains: Victory (7290696200003) - ויקטורי, H. Cohen (7290455000004) - ח. כהן, Mahsanei HaShuk (7290661400001) - מחסני השוק",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// {{date}} = collection variable (YYYY-MM-DD) or today when empty.",
          "const pad = n => String(n).padStart(2, '0');",
          "const now = new Date();",
          "const iso = pm.collectionVariables.get('date') || `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;",
          "const [y, m, d] = iso.split('-');",
          "pm.variables.set('date', iso);",
          "pm.variables.set('dateCompact', y + m + d);",
          "pm.variables.set('dateDmy', `${d}/${m}/${y}`);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "date",
      "value": "",
      "description": "YYYY-MM-DD; empty = today"
    },
    {
      "key": "fileName",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Victory (7290696200003)",
      "item": [
        {
          "name": "List files",
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://laibcatalog.co.il/webapi/api/getfiles?edi=7290696200003"
          },
          "protocolProfileBehavior": {
            "strictSSL": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const item = (pm.response.json()).find(f => (f.fileName || '').startsWith('PriceFull'));",
                  "pm.test('found a PriceFull file', () => pm.expect(item).to.not.equal(undefined));",
                  "if (item) {",
                  "    pm.collectionVariables.set('fileName', item.fileName);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Download file",
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://laibcatalog.co.il/webapi/7290696200003/{{fileName}}",
            "description": "Use \"Send and Download\" to save the file."
          },
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        }
      ],
      "description": "Victory (7290696200003) - ויקטורי"
    },
