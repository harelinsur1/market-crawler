{
  "info": {
    "name": "www.citymarket-shops.co.il",
    "description": "City Market portal - paged HTML table filtered by day. Chains: City Market (7290000000003) - סיטי מרקט.\n\nFile names are shown without extension; downloads are `.xml.gz`. The last page number is in the `?p=N` pager links.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// {{date}} = collection variable (YYYY-MM-DD) or today when empty.",
          "const pad = n => String(n).padStart(2, '0');",
          "const now = new Date();",
          "const iso = pm.collectionVariables.get('date') || `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;",
          "const [y, m, d] = iso.split('-');",
          "pm.variables.set('date', iso);",
          "pm.variables.set('dateCompact', y + m + d);",
          "pm.variables.set('dateDmy', `${d}/${m}/${y}`);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "date",
      "value": "",
      "description": "YYYY-MM-DD; empty = today"
    },
    {
      "key": "fileName",
      "value": ""
    },
    {
      "key": "fileUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "List PriceFull files",
      "request": {
        "method": "GET",
        "header": [],
        "url": "https://www.citymarket-shops.co.il/?p=1&t=1&f=1&d={{date}}"
      },
      "protocolProfileBehavior": {
        "strictSSL": false
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const m = pm.response.text().match(/<td>\\s*(PriceFull[^<\\s]+)\\s*<\\/td>[\\s\\S]*?href=\"(\\/downloadFile\\/[^\"]+)\"/);",
              "pm.test('found a PriceFull file', () => pm.expect(m).to.not.equal(null));",
              "if (m) {",
              "    pm.collectionVariables.set('fileName', m[1] + '.xml.gz');",
              "    pm.collectionVariables.set('fileUrl', 'https://www.citymarket-shops.co.il' + m[2]);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Download file",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{fileUrl}}",
        "description": "Use \"Send and Download\" to save the file."
      },
      "protocolProfileBehavior": {
        "strictSSL": false
      }
    }
  ]
}
