{
  "info": {
    "name": "wm-gateway.wolt.com",
    "description": "Wolt price feed - static HTML index per day. Chains: Wolt (7290058249350) - וולט מרקט.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// {{date}} = collection variable (YYYY-MM-DD) or today when empty.",
          "const pad = n => String(n).padStart(2, '0');",
          "const now = new Date();",
          "const iso = pm.collectionVariables.get('date') || `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;",
          "const [y, m, d] = iso.split('-');",
          "pm.variables.set('date', iso);",
          "pm.variables.set('dateCompact', y + m + d);",
          "pm.variables.set('dateDmy', `${d}/${m}/${y}`);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "date",
      "value": "",
      "description": "YYYY-MM-DD; empty = today"
    },
    {
      "key": "fileUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "List PriceFull files",
      "request": {
        "method": "GET",
        "header": [],
        "url": "https://wm-gateway.wolt.com/isr-prices/public/v1/{{date}}.html"
      },
      "protocolProfileBehavior": {
        "strictSSL": false
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const m = pm.response.text().match(/href=\"([^\"]*?\\/(PriceFull[^\"\\/]+))\"/);",
              "pm.test('found a PriceFull file', () => pm.expect(m).to.not.equal(null));",
              "if (m) {",
              "    pm.collectionVariables.set('fileUrl', 'https://wm-gateway.wolt.com/isr-prices/public/v1/' + m[1]);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Download file",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{fileUrl}}",
        "description": "Use \"Send and Download\" to save the file."
      },
      "protocolProfileBehavior": {
        "strictSSL": false
      }
    }
  ]
}
